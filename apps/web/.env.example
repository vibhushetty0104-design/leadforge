# LEADFORGE web app. Copy to apps/web/.env.local for local development.
# All values are read on the server at request time (not inlined at build), so
# one build or Docker image can be configured per environment.

# Supabase project URL and *publishable* (anon) key from Project Settings -> API.
# The publishable key is safe for browsers. NEVER put the service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Base URL of the LEADFORGE API, reachable from the Next.js server.
API_BASE_URL=http://localhost:8000
