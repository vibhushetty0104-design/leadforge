# LEADFORGE backend configuration (API, worker, migrations, Docker Compose).
# Copy to `.env` in the repository root and fill in values. Never commit `.env`.
# The web app has its own file: apps/web/.env.example

# --- General -----------------------------------------------------------------
# development | test | staging | production  (staging/production enable strict checks)
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON logs for deployed environments; plain text is easier to read locally.
LOG_JSON=false

# --- Database ----------------------------------------------------------------
# Password for the local Docker Postgres container. Choose your own value.
POSTGRES_PASSWORD=
# Used by the API, worker and Alembic when running on your machine (outside Docker).
# Local Docker Postgres:  postgresql://leadforge:<POSTGRES_PASSWORD>@localhost:5432/leadforge
# Supabase: Project Settings -> Database -> Connection string (use the pooler URL).
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- Authentication (Supabase Auth) ------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co, or http://127.0.0.1:54321 for `supabase start`.
# Access tokens are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=
# Only for projects still on the legacy shared JWT secret (or the local Supabase CLI).
# Leave empty when your project uses asymmetric JWT signing keys.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# NEVER set the Supabase service-role key anywhere in this project.

# --- API -----------------------------------------------------------------------
PORT=8000
# Exact origins allowed to call the API from a browser (comma-separated, no wildcards).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Defaults to enabled outside production when left empty.
API_DOCS_ENABLED=
# Reverse-proxy addresses whose X-Forwarded-* headers are trusted.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Worker ----------------------------------------------------------------------
# Defaults to <hostname>-<pid> when empty.
WORKER_ID=
POLL_INTERVAL_SECONDS=2
MAX_POLL_INTERVAL_SECONDS=30
LEASE_SECONDS=300
# Optional comma-separated subset: website_audit,lead_scoring,import
WORKER_JOB_TYPES=

# --- Tests -------------------------------------------------------------------------
# Optional. When set, backend tests run against this Postgres database (it is wiped!).
# Its name must contain "test", and it must differ from DATABASE_URL.
# When empty, tests use in-memory SQLite.
TEST_DATABASE_URL=
